# Porta do Painel de Controle Web
PORT=3000

# Chave de Transmissão do YouTube Live (obtenha em https://studio.youtube.com)
YOUTUBE_STREAM_KEY=

# Servidor RTMP do YouTube (Padrão: rtmp://a.rtmp.youtube.com/live2)
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# Senha de Administração do Painel (Opcional)
ADMIN_PASSWORD=admin123

# Qualidade do Vídeo
RESOLUTION=1080p
VIDEO_BITRATE=4500k
AUDIO_BITRATE=160k
