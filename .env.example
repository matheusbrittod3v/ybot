# ============================================================
# CONFIGURAÇÕES DO DOKPLOY / TRAEFIK (ZERO HARDCODE)
# ============================================================
# Seu domínio de acesso (ex: tvbraza.seudominio.com ou live.tvbraza.com)
DOMAIN=localhost

# Porta interna do Painel de Controle Web
PORT=3000

# Nome do serviço e rede do Traefik no Dokploy
TRAEFIK_SERVICE_NAME=tvbraza
DOKPLOY_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_TLS=true
CONTAINER_NAME=tvbraza-studio-24h

# ============================================================
# CONFIGURAÇÕES DO YOUTUBE LIVE & TRANSMISSÃO
# ============================================================
# Chave de Transmissão do YouTube Live (obtenha em https://studio.youtube.com)
YOUTUBE_STREAM_KEY=

# Servidor RTMP do YouTube (Padrão: rtmp://a.rtmp.youtube.com/live2)
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# ID do Vídeo da Live atual no YouTube (ex: dQw4w9WgXcQ)
YOUTUBE_BROADCAST_VIDEO_ID=

# Credenciais Google Cloud / YouTube Data API (Opcional para troca automática de título e thumb)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ============================================================
# AJUSTES DE SISTEMA E VÍDEO
# ============================================================
# Senha de Administração do Painel (Opcional)
ADMIN_PASSWORD=admin123

# Qualidade do Vídeo
RESOLUTION=1080p
VIDEO_BITRATE=4500k
AUDIO_BITRATE=160k
NODE_ENV=production
